# ==============================================================================
# gabe-whats — Configuração de Ambiente (Modelo)
# ==============================================================================
# Copie para `.env` e ajuste aos valores locais. Nunca commite o `.env` real.

# --- API REST (apps/api) ---
# Endereço HTTP em que o daemon escuta (local por padrão).
GABE_WHATS_HTTP_ADDR=127.0.0.1:8080
# Chave exigida em `X-API-Key` ou `Authorization: Bearer` em /api/v1/*.
GABE_WHATS_API_KEY=troque-por-sua-chave-secreta
# SQLite de SESSÃO do whatsmeow (estado criptográfico Signal). Não exponha SQL direto.
GABE_WHATS_SQLITE_DSN=file:./data/session.db?_foreign_keys=on
# SQLite PRÓPRIO do daemon (fora do session.db do whatsmeow): cache de enquetes
# (hash SHA-256 -> texto da opção) e persistência da configuração de webhooks.
GABE_WHATS_APP_DSN=file:./data/app.db
# Diretório onde mídias baixadas/descriptografadas são guardadas.
GABE_WHATS_MEDIA_DIR=./data/media
# TTL da URL temporária de mídia (download_url + expires_at), servida em
# GET /api/v1/media/{id}. Formato Go de duração (ex.: 15m, 1h). Padrão: 15m.
GABE_WHATS_MEDIA_URL_TTL=15m
GABE_WHATS_LOG_LEVEL=info

# --- Webhook & Segurança para Agentes ---
# URL do seu OpenClaw / Moltbot / Hermes / Agent Zero que receberá eventos POST
GABE_WHATS_WEBHOOK_URL=http://127.0.0.1:18789/webhooks/whatsapp
GABE_WHATS_WEBHOOK_SECRET=segredo-hmac-opcional
GABE_WHATS_WEBHOOK_IGNORE_FROM_ME=true
# Lista separada por vírgula (vazio = todos os chats). Ex: 5511999999999@s.whatsapp.net
GABE_WHATS_WEBHOOK_ALLOW_JIDS=
GABE_WHATS_AUTO_DOWNLOAD_MEDIA=true
GABE_WHATS_WEBHOOK_INCLUDE_BASE64=false

# --- Servidor MCP (apps/mcp) ---
# URL e chave da API REST consumida pelo servidor MCP (ele é stateless).
GABE_WHATS_API_URL=http://127.0.0.1:8080
# ATENÇÃO: o transporte do servidor MCP NÃO é lido de variáveis de ambiente.
# Os valores antigos GABE_WHATS_MCP_TRANSPORT / GABE_WHATS_MCP_SSE_ADDR nunca
# foram lidos pelo binário; use as flags da linha de comando do apps/mcp:
#   --transport stdio|sse        (padrão: stdio)
#   --sse-addr 127.0.0.1:8090    (somente com --transport sse)
